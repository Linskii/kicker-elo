rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if the requesting user is an admin
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper to validate Elo change is within reasonable bounds (-50 to +50)
    function isValidEloChange(oldElo, newElo) {
      let diff = newElo - oldElo;
      return diff >= -50 && diff <= 50;
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for leaderboards, match history)
      allow read: if true;

      // Users can create their own profile
      allow create: if isOwner(userId)
        && request.resource.data.elo == 1000
        && request.resource.data.matchesPlayed == 0
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0;

      // Users can update their own profile (non-stat fields only, isAdmin is also protected)
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['elo', 'matchesPlayed', 'wins', 'losses', 'isAdmin']);

      // Allow stat updates from any match participant when a match completes
      // This allows the match creator to update all participants' stats
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['elo', 'matchesPlayed', 'wins', 'losses'])
        && isValidEloChange(resource.data.elo, request.resource.data.elo)
        && request.resource.data.matchesPlayed == resource.data.matchesPlayed + 1
        && (
          (request.resource.data.wins == resource.data.wins + 1 && request.resource.data.losses == resource.data.losses)
          ||
          (request.resource.data.losses == resource.data.losses + 1 && request.resource.data.wins == resource.data.wins)
        );

      // Allow ELO/wins/losses correction when a match result is edited (no matchesPlayed change)
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['elo', 'wins', 'losses'])
        && request.resource.data.matchesPlayed == resource.data.matchesPlayed
        && request.resource.data.elo - resource.data.elo >= -200
        && request.resource.data.elo - resource.data.elo <= 200
        && request.resource.data.wins >= resource.data.wins - 1
        && request.resource.data.wins <= resource.data.wins + 1
        && request.resource.data.losses >= resource.data.losses - 1
        && request.resource.data.losses <= resource.data.losses + 1;

      // Allow ELO reset to 1000 at season start (only elo changes, no other fields)
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['elo'])
        && request.resource.data.elo == 1000;
    }

    // Relationships collection (friendships)
    match /relationships/{relationshipId} {
      // Users can read relationships they're part of
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.users;

      // Users can create a relationship if they're the sender
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.senderId
        && request.auth.uid in request.resource.data.users;

      // Users can update relationships they're part of (accept/remove)
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.users;

      // Either user can delete the relationship
      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.users;
    }

    // Config collection (season tracking)
    match /config/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && document == "seasons";
    }

    // Seasons collection (historical season snapshots)
    match /seasons/{seasonId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && seasonId.matches('^[0-9]{4}-[0-9]{2}$');
      // Only admins can update (label edits) or delete seasons
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label']);
      allow delete: if isAdmin();
    }

    // Matches collection
    match /matches/{matchId} {
      // Anyone can read matches (public match history)
      allow read: if true;

      // Authenticated users can create matches
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants;

      // Participants can update live/lobby matches (goals, swaps, status transitions)
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && resource.data.status != 'completed';

      // Participants can edit a completed match within the 10-minute window
      // request.time is Firebase server time — cannot be manipulated by the client
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && resource.data.status == 'completed'
        && request.time.toMillis() <= resource.data.endedAt.toMillis() + 600000;

      // Lobby can be deleted by any participant; live match only by creator
      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && (
          resource.data.status == 'lobby'
          || (resource.data.status == 'live' && resource.data.createdBy == request.auth.uid)
        );
    }
  }
}
